theorem r12_row_65 (hGRH : DirichletLZerosOnLine) (hZ : R11ZetaZ) (hA : R11ZetaExplicit)
    (hC : R11ChiExplicit) (hG : R11ZeroSumGain) :
    ∀ n : ℕ, (10 : ℝ) ^ 13 ≤ n → R12Bound 0.65 n := by
  intro n hn
  have hL := r11Asm_log_ge_of_pow hn
  have hn0 : ((((491 : ℕ) : ℝ) / 100) ^ 2 ≤ 0.80622 * Real.log n) := by
    norm_num at hL ⊢; linarith
  by_cases h0 : √(0.80622 * Real.log n) ≤ 8.63
  · refine r12_rowB hGRH hZ hA hC hG (c := 0.65) (k := 0.80622)
        (W₀ := ((491 : ℕ) : ℝ) / 100) (l₁ := ((637 : ℕ) : ℝ) / 100) (fun W => W ≤ (8.63 : ℝ))
        (by norm_num) (by norm_num) (by norm_num) (by norm_num) (by norm_num)
        (r11Asm_log4_le 491 637 (by norm_num) (by decide +kernel)) (by norm_num) ?_ n hn0 h0
    intro W h0 h1
    have h1' : W ≤ 8.63 := h1
    norm_num [r12Err] at h0 ⊢
    nlinarith [sq_nonneg (W - 8.63)]
  · have hn1 : ((((863 : ℕ) : ℝ) / 100) ^ 2 ≤ 0.80622 * Real.log n) := by
      have := (Real.lt_sqrt (by norm_num)).mp (not_le.mp h0)
      norm_num at this ⊢; linarith
    refine r12_rowB hGRH hZ hA hC hG (c := 0.65) (k := 0.80622)
        (W₀ := ((863 : ℕ) : ℝ) / 100) (l₁ := ((863 : ℕ) : ℝ) / 100) (fun _ => True)
        (by norm_num) (by norm_num) (by norm_num) (by norm_num) (by norm_num)
        (r11Asm_log4_le 863 863 (by norm_num) (by decide +kernel)) (by norm_num) ?_ n hn1 trivial
    intro W h0 _
    norm_num [r12Err] at h0 ⊢
    nlinarith [sq_nonneg (W - 15.96)]

/-- **miller4.md Theorem M4** (table).  Under GRH and the Round-11 Props, for every `n ≥ N₀` every
subgroup `H ≤ (ZMod n)ˣ` of index `≥ 4` misses some `1 ≤ a < c log² n`. -/
theorem r12_subgroup_table (hGRH : DirichletLZerosOnLine) (hZ : R11ZetaZ)
    (hA : R11ZetaExplicit) (hC : R11ChiExplicit) (hG : R11ZeroSumGain) :
    (∀ n : ℕ, (10 : ℝ) ^ 10 ≤ n → R12Bound 0.75 n) ∧
    (∀ n : ℕ, (10 : ℝ) ^ 10 ≤ n → R12Bound 0.72 n) ∧
    (∀ n : ℕ, (10 : ℝ) ^ 11 ≤ n → R12Bound 0.7 n) ∧
    (∀ n : ℕ, (10 : ℝ) ^ 11 ≤ n → R12Bound 0.68 n) ∧
    (∀ n : ℕ, (10 : ℝ) ^ 12 ≤ n → R12Bound 0.66 n) ∧
    (∀ n : ℕ, (10 : ℝ) ^ 13 ≤ n → R12Bound 0.65 n) :=
  ⟨r12_row_75 hGRH hZ hA hC hG, r12_row_72 hGRH hZ hA hC hG, r12_row_70 hGRH hZ hA hC hG,
    r12_row_68 hGRH hZ hA hC hG, r12_row_66 hGRH hZ hA hC hG, r12_row_65 hGRH hZ hA hC hG⟩

/-- The table with `R12Bound` unfolded. -/
theorem r12_subgroup_table' (hGRH : DirichletLZerosOnLine) (hZ : R11ZetaZ)
    (hA : R11ZetaExplicit) (hC : R11ChiExplicit) (hG : R11ZeroSumGain) :
    ∀ c : ℝ, ∀ N : ℕ, (c = 0.75 ∧ N = 10) ∨ (c = 0.72 ∧ N = 10) ∨ (c = 0.7 ∧ N = 11) ∨
        (c = 0.68 ∧ N = 11) ∨ (c = 0.66 ∧ N = 12) ∨ (c = 0.65 ∧ N = 13) →
      ∀ n : ℕ, (10 : ℝ) ^ N ≤ n → ∀ H : Subgroup (ZMod n)ˣ, 4 ≤ H.index →
        ∃ a : ℕ, 1 ≤ a ∧ (a : ℝ) < c * Real.log n ^ 2 ∧
          (¬ IsUnit (a : ZMod n) ∨ ∃ u : (ZMod n)ˣ, (u : ZMod n) = a ∧ u ∉ H) := by
  obtain ⟨h1, h2, h3, h4, h5, h6⟩ := r12_subgroup_table hGRH hZ hA hC hG
  rintro c N (⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩) n hn
  · exact h1 n hn
  · exact h2 n hn
  · exact h3 n hn
  · exact h4 n hn
  · exact h5 n hn
  · exact h6 n hn

/-- **miller4.md Theorem M4** (eventual form): every `c > 0.6417` works for all large `n`. -/
theorem r12_eventually (hGRH : DirichletLZerosOnLine) (hZ : R11ZetaZ)
    (hA : R11ZetaExplicit) (hC : R11ChiExplicit) (hG : R11ZeroSumGain) :
    ∀ c : ℝ, 0.6417 < c → ∃ N₀ : ℕ, ∀ n : ℕ, N₀ ≤ n → ∀ H : Subgroup (ZMod n)ˣ, 4 ≤ H.index →
      ∃ a : ℕ, 1 ≤ a ∧ (a : ℝ) < c * Real.log n ^ 2 ∧
        (¬ IsUnit (a : ZMod n) ∨ ∃ u : (ZMod n)ˣ, (u : ZMod n) = a ∧ u ∉ H) := by
  intro c hc
  refine ⟨⌈Real.exp (10 ^ 8 / 0.80106)⌉₊, fun n hn => ?_⟩
  have hn' : Real.exp (10 ^ 8 / 0.80106) ≤ n := Nat.ceil_le.mp hn
  have hn0 : (0 : ℝ) < n := lt_of_lt_of_le (Real.exp_pos _) hn'
  have hL : (10 : ℝ) ^ 8 / 0.80106 ≤ Real.log n := (Real.le_log_iff_exp_le hn0).mpr hn'
  have hnW : ((((1000000 : ℕ) : ℝ) / 100) ^ 2 ≤ 0.80106 * Real.log n) := by
    have := mul_le_mul_of_nonneg_left hL (by norm_num : (0 : ℝ) ≤ 0.80106)
    norm_num at this ⊢; linarith
  refine r12_rowB hGRH hZ hA hC hG (c := c) (k := 0.80106)
      (W₀ := ((1000000 : ℕ) : ℝ) / 100) (l₁ := ((3700 : ℕ) : ℝ) / 100) (fun _ => True)
      (by norm_num) (by norm_num) (by norm_num at hc ⊢; linarith) (by norm_num) (by norm_num)
      (r11Asm_log4_le 1000000 3700 (by norm_num) (by decide +kernel)) (by norm_num) ?_ n hnW
      trivial
  intro W h0 _
  norm_num [r12Err] at h0 ⊢
  nlinarith [sq_nonneg (W - 10000)]

