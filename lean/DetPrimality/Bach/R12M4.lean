/-!
# Round 12 (miller4.md Theorem M4): subgroups of index `≥ 4`, explicit `c < 0.76`

Under GRH and the Round-11 Props `R11ZetaZ`, `R11ZetaExplicit`, `R11ChiExplicit`, `R11ZeroSumGain`
(kernel `6/(s+1)⁴`, `λ = 1/4`, `x = 4X`), with the proved tail bound `r11TailS_sharp`:

* `r12_subgroup_table`: `R12Bound c n` for all `n ≥ N₀`, for
  `(c, N₀) = (0.75, 10¹⁰), (0.72, 10¹⁰), (0.70, 10¹¹), (0.68, 10¹¹), (0.66, 10¹²), (0.65, 10¹³)`;
* `r12_eventually`: for every `c > 0.6417`, `R12Bound c n` for all `n ≥ N₀`
  (`N₀ = ⌈exp(10⁸/0.80106)⌉`, independent of `c`).

`R12Bound c n`: every subgroup `H ≤ (ZMod n)ˣ` of index `≥ 4` misses some `1 ≤ a < c log² n`.
The rows are generated by `research/barrier/r12M4_gen/emit.py`.
-/

set_option exponentiation.threshold 20000

open Complex DirichletCharacter

namespace DetPrimality.Bach

theorem r12_rowB (hGRH : DirichletLZerosOnLine) (hZ : R11ZetaZ) (hA : R11ZetaExplicit)
    (hC : R11ChiExplicit) (hG : R11ZeroSumGain) {c k W₀ l₁ : ℝ}
    (P : ℝ → Prop) (hk0 : 0 < k) (hk1 : k ≤ 1) (hkc : k ^ 2 ≤ c)
    (hW₀ : 3 ≤ W₀) (h250 : 250 ≤ W₀ ^ 4) (hl₁ : Real.log (W₀ ^ 4) ≤ l₁) (h6 : 6 ≤ l₁)
    (hF : ∀ W : ℝ, W₀ ≤ W → P W → r12Err 1.093 1.84 1.1734 (1 / k) W₀ l₁
      < (7.4904 - 6 * (1 / k)) * W ^ 2 - 1.5403 * W + 74.0104)
    (n : ℕ) (hn : W₀ ^ 2 ≤ k * Real.log n) (hP : P (√(k * Real.log n))) : R12Bound c n :=
  r12_row hGRH hZ hA hC hG (a := 1.093) (b := 1.84) (d := 1.1734) (by norm_num)
    (by norm_num) (by norm_num) (fun X hX => r11TailS_sharp X (h250.trans hX))
    P hk0 hk1 hkc hW₀ hl₁ h6 hF n hn hP

theorem r12_row_75 (hGRH : DirichletLZerosOnLine) (hZ : R11ZetaZ) (hA : R11ZetaExplicit)
    (hC : R11ChiExplicit) (hG : R11ZeroSumGain) :
    ∀ n : ℕ, (10 : ℝ) ^ 10 ≤ n → R12Bound 0.75 n := by
  intro n hn
  have hL := r11Asm_log_ge_of_pow hn
  have hn0 : ((((446 : ℕ) : ℝ) / 100) ^ 2 ≤ 0.86602 * Real.log n) := by
    norm_num at hL ⊢; linarith
  refine r12_rowB hGRH hZ hA hC hG (c := 0.75) (k := 0.86602)
      (W₀ := ((446 : ℕ) : ℝ) / 100) (l₁ := ((600 : ℕ) : ℝ) / 100) (fun _ => True)
      (by norm_num) (by norm_num) (by norm_num) (by norm_num) (by norm_num)
      (r11Asm_log4_le 446 600 (by norm_num) (by decide +kernel)) (by norm_num) ?_ n hn0 trivial
  intro W h0 _
  norm_num [r12Err] at h0 ⊢
  nlinarith [sq_nonneg (W - 4.46)]

