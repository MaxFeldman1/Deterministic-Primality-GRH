/-!
# Round 11 assembly, part 3: the `(c, N₀)` tables and the eventual statement

* `r11Asm_table_of_tail` : from `R11Tail 2`:  `(0.95, 10¹²)`, `(0.9, 10¹⁴)`, `(0.85, 10¹⁶)`,
  `(0.8, 10¹⁹)`.
* `r11Asm_table` : with the proved sharpened tail bound `r11TailS_sharp` (no tail hypothesis):
  `(0.95, 10⁹)`, `(0.9, 10¹⁰)`, `(0.85, 10¹¹)`, `(0.8, 10¹³)`;
  `r11Asm_table_low` : `(0.79, 10¹³)`, `(0.78, 10¹⁴)`.
* `r11Asm_eventually` : for every `c > 0.7772`, `R11Bound c n` for all `n ≥ N₀`
  (`N₀ = ⌈exp(10⁸/0.88158)⌉`, independent of `c`).

The rows are generated by `research/below-one/r11Asm_gen/emit.py`: `k² ≤ c`, `W₀² ≤ k log N₀`,
`ℓ₁ ≥ max (log W₀⁴) 6`; where the vertex of the quadratic lies to the right of `W₀` the range of
`W = √(k log n)` is split.
-/

set_option exponentiation.threshold 20000

open Complex DirichletCharacter

namespace DetPrimality.Bach

/-- `log((A/100)⁴) ≤ p/100` from an integer certificate. -/
theorem r11Asm_log4_le (A p : ℕ) (hA : 0 < A)
    (h : A ^ 400 * (10 ^ 10) ^ p ≤ 27182818283 ^ p * 100 ^ 400) :
    Real.log (((A : ℝ) / 100) ^ 4) ≤ (p : ℝ) / (100 : ℕ) := by
  have hA0 : (0 : ℝ) < A := by exact_mod_cast hA
  refine r11Asm_log_le (by positivity) p 100 (by norm_num) ?_
  have e1 : (((A : ℝ) / 100) ^ 4) ^ 100 = (A : ℝ) ^ 400 / 100 ^ 400 := by
    rw [← pow_mul, div_pow]
  have e2 : (2.7182818283 : ℝ) ^ p = (27182818283 : ℝ) ^ p / (10 ^ 10) ^ p := by
    rw [← div_pow]; norm_num
  rw [e1, e2, div_le_div_iff₀ (by positivity) (by positivity)]
  exact_mod_cast h

theorem r11Asm_rowA (hGRH : DirichletLZerosOnLine) (hZ : R11ZetaZ) (hA : R11ZetaExplicit)
    (hC : R11ChiExplicit) (hG : R11ZeroSumGain) (hT : R11Tail 2) {c k W₀ l₁ : ℝ}
    (P : ℝ → Prop) (hk0 : 0 < k) (hk1 : k ≤ 1) (hkc : k ^ 2 ≤ c)
    (hW₀ : 3 ≤ W₀) (hl₁ : Real.log (W₀ ^ 4) ≤ l₁) (h6 : 6 ≤ l₁)
    (hF : ∀ W : ℝ, W₀ ≤ W → P W → r11AsmErr 2 0 0 (1 / k) W₀ l₁
      < (5.1046 - 4.5 * (1 / k)) * W ^ 2 - 1.1499 * W + 55.4247)
    (n : ℕ) (hn : W₀ ^ 2 ≤ k * Real.log n) (hP : P (√(k * Real.log n))) : R11Bound c n := by
  refine r11Asm_row hGRH hZ hA hC hG (a := 2) (b := 0) (d := 0) (by norm_num) le_rfl le_rfl
    (fun X hX => ?_) P hk0 hk1 hkc hW₀ hl₁ h6 hF n hn hP
  have h81 : (81 : ℝ) ≤ W₀ ^ 4 := by
    calc (81 : ℝ) = 3 ^ 4 := by norm_num
      _ ≤ W₀ ^ 4 := pow_le_pow_left₀ (by norm_num) hW₀ 4
  have := hT X (by linarith)
  simpa using this

theorem r11Asm_rowB (hGRH : DirichletLZerosOnLine) (hZ : R11ZetaZ) (hA : R11ZetaExplicit)
    (hC : R11ChiExplicit) (hG : R11ZeroSumGain) {c k W₀ l₁ : ℝ}
    (P : ℝ → Prop) (hk0 : 0 < k) (hk1 : k ≤ 1) (hkc : k ^ 2 ≤ c)
    (hW₀ : 3 ≤ W₀) (h250 : 250 ≤ W₀ ^ 4) (hl₁ : Real.log (W₀ ^ 4) ≤ l₁) (h6 : 6 ≤ l₁)
    (hF : ∀ W : ℝ, W₀ ≤ W → P W → r11AsmErr 1.093 1.84 1.1734 (1 / k) W₀ l₁
      < (5.1046 - 4.5 * (1 / k)) * W ^ 2 - 1.1499 * W + 55.4247)
    (n : ℕ) (hn : W₀ ^ 2 ≤ k * Real.log n) (hP : P (√(k * Real.log n))) : R11Bound c n :=
  r11Asm_row hGRH hZ hA hC hG (a := 1.093) (b := 1.84) (d := 1.1734) (by norm_num)
    (by norm_num) (by norm_num) (fun X hX => r11TailS_sharp X (h250.trans hX))
    P hk0 hk1 hkc hW₀ hl₁ h6 hF n hn hP

