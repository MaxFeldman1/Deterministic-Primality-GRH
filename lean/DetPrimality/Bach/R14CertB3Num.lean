import Mathlib
import DetPrimality.Bach.R14CertGen

/-!
# Round 14 certificates with three exact sign changes: the signed combination of `R14Cert.num` for `p = 3`

Companion of `r14Cert_num_p1`, `r14Cert_num_p2` (`R14CertGen.lean`), used by the instances generated by
`research/barrier/formal07605_emit.py`.
-/

namespace DetPrimality.Bach

theorem r14Cert_num_p3 (F : ℝ → ℝ) (b : ℕ → ℝ) :
    F (b (3 + 1)) - ∑ i ∈ Finset.range (3 + 1), (-1) ^ (3 - i) * (F (b i) - F (b (i + 1)))
      = 2 * F (b 4) - 2 * F (b 3) + 2 * F (b 2) - 2 * F (b 1) + F (b 0) := by
  simp only [Finset.sum_range_succ, Finset.sum_range_zero]
  norm_num
  ring

end DetPrimality.Bach

#print axioms DetPrimality.Bach.r14Cert_num_p3
