import DetPrimality.Barrier.dual_Coeff
import DetPrimality.Barrier.dual2_RunAll

/-!
# The limit of the CMQR framework, refined: `C(1) ≤ 1.146514`

Same statement and proof as `dual_Main.lean` (`cmqr_EP1_le`, `C(1) ≤ 1.14654`), with a finer dual
function: `ψ(t) = s(2πt) e^{πt}`, `s` the step function with 34 steps on `[0, 8]` encoded by
`dual2VD` (four optimised switch points, then a tail grid of mesh `0.1` on `[2.1, 3]` and `0.25` on
`[3, 8]`; found by `research/barrier/dual2_socp.py`).  The bound `2π ‖𝓕 g‖_∞ ≤ 1.146514` is checked in
the kernel with the checker of `dual_Cert.lean` (`dual_cert`, `dual_cert_chain`; 22381 cells, data
generated by `research/barrier/dual2_gen.py`).

Numerically the value of the dual problem (EP2) at `A = 1` is `≈ 1.146513` and the primal value is
`≈ 1.146512` (`research/barrier/inside.md`), so `1.146514` is sharp to about `10⁻⁶`:
`C(1)⁻² ≥ 0.760748`.
-/

open MeasureTheory Set
open scoped FourierTransform Real

namespace DetPrimality.Barrier

theorem dual2Data_coeff : dualCoeffOK dual2VD dual2VA ((1 : ℚ) / 100000000) = true := by
  decide +kernel

/-- The refined dual function `g = 1_{t<0} e^{πt} - 1_{t>0} ψ`. -/
noncomputable def dual2Fn : ℝ → ℝ := dualG (dualL dual2VD)

theorem dual2Fn_integrable : Integrable dual2Fn := dualG_integrable _

theorem dual2Fn_neg {t : ℝ} (ht : t < 0) : dual2Fn t = Real.exp (π * t) := by
  have h := (dualCoeffOK_sound dual2Data_coeff).2.1 (2 * π * t)
    (by have := Real.pi_pos; nlinarith)
  rw [dual2Fn, dualG_eq, h, mul_one]

theorem dual2Fn_pos (t : ℝ) : |dual2Fn t| ≤ Real.exp (π * t) := by
  have h := (dualCoeffOK_sound dual2Data_coeff).1 (2 * π * t)
  rw [dual2Fn, dualG_eq, abs_mul, abs_of_pos (Real.exp_pos _)]
  exact mul_le_of_le_one_right (Real.exp_pos _).le h

/-- `sup_y |N(y)| / √(1/4 + y²) ≤ 1.146514` for the exponential sum of the dual function. -/
theorem dual2N_bound (y : ℝ) :
    ‖dualN (dualL dual2VD) y‖ ≤ 1.146514 * Real.sqrt (1 / 4 + y ^ 2) := by
  have h1 := (dualCoeffOK_sound dual2Data_coeff).2.2 y
  have hrun : ∀ t : ℝ, 0 ≤ t → t < (dual2Yf : ℝ) / dQ → DualBd dual2Par dual2VA t := by
    intro t h0 ht
    refine dual_cert_chain dual2Data_par dual2Data_rots dual2Chain (dualInit dual2VA)
      (dualInit_inv _) dual2Data_chain t (by simpa [dualInit] using h0) ?_
    rw [dual2Data_end]; exact ht
  have h2 := dual_cert dual2Data_par hrun dual2Data_tail y
  have hcp : (dual2Par.Cn : ℝ) / dCd = 1.1465139 := by simp [dual2Par, dCd]; norm_num
  rw [hcp] at h2
  have hs : (1 / 2 : ℝ) ≤ Real.sqrt (1 / 4 + y ^ 2) := by
    have := Real.abs_le_sqrt (x := 1 / 2) (y := 1 / 4 + y ^ 2) (by nlinarith [sq_nonneg y])
    rwa [abs_of_pos (by norm_num)] at this
  have h3 : ‖dualN (dualL dual2VD) y‖ ≤ ‖dualNq dual2VA y‖ + ((1 / 100000000 : ℚ) : ℝ) := by
    have := norm_le_norm_add_norm_sub' (dualN (dualL dual2VD) y) (dualNq dual2VA y)
    linarith
  push_cast at h3
  linarith

/-- `2π ‖𝓕 g‖_∞ ≤ 1.146514`: the value of (EP2) at `A = 1` is at most `1.146514`. -/
theorem dual2Fn_fourier_bound (x : ℝ) :
    ‖𝓕 (fun t => (dual2Fn t : ℂ)) x‖ ≤ 1.146514 / (2 * π) := by
  have hpi := Real.pi_pos
  have hs : 0 < Real.sqrt (1 / 4 + x ^ 2) := Real.sqrt_pos.mpr (by positivity)
  have h := dual2N_bound (-x)
  rw [neg_sq] at h
  unfold dual2Fn
  rw [dualG_fourier_norm, div_le_div_iff₀ (by positivity) (by positivity)]
  nlinarith [mul_le_mul_of_nonneg_right h (by positivity : (0 : ℝ) ≤ 2 * π)]

/-- **The framework limit `C(1) ≤ 1.146514`** (CMQR (EP1), `A = 1`).  For `F ∈ L¹(ℝ)` with
real-valued Fourier transform, such that the (EP1) functional is not `-∞` (`hint`). -/
theorem dual2_EP1_le {F : ℝ → ℂ} (hF : Integrable F) (hreal : ∀ t, (𝓕 F t).im = 0)
    (hint : IntegrableOn (fun t => (𝓕 F t).re * Real.exp (π * t)) (Ioi 0)) :
    2 * π * ((∫ t in Iic 0, (𝓕 F t).re * Real.exp (π * t))
        - ∫ t in Ioi 0, |(𝓕 F t).re| * Real.exp (π * t))
      ≤ 1.146514 * ∫ x, ‖F x‖ := by
  have hpi := Real.pi_pos
  have h := dual_weak_duality hF hreal dual2Fn_integrable (fun t ht => dual2Fn_neg ht)
    (fun t _ => dual2Fn_pos t) dual2Fn_fourier_bound hint
  rw [integral_Iic_eq_integral_Iio]
  have h2 := mul_le_mul_of_nonneg_left h (by positivity : (0 : ℝ) ≤ 2 * π)
  refine h2.trans (le_of_eq ?_)
  field_simp

/-- The same in normalised form: `J(F) ≤ 1.146514` for `F ≠ 0`. -/
theorem dual2_C_one_le {F : ℝ → ℂ} (hF : Integrable F) (hreal : ∀ t, (𝓕 F t).im = 0)
    (hint : IntegrableOn (fun t => (𝓕 F t).re * Real.exp (π * t)) (Ioi 0))
    (h0 : 0 < ∫ x, ‖F x‖) :
    2 * π / (∫ x, ‖F x‖) * ((∫ t in Iic 0, (𝓕 F t).re * Real.exp (π * t))
        - ∫ t in Ioi 0, |(𝓕 F t).re| * Real.exp (π * t))
      ≤ 1.146514 := by
  have h := dual2_EP1_le hF hreal hint
  rw [div_mul_eq_mul_div, div_le_iff₀ h0]
  exact h

/-- `C(1)⁻² ≥ 0.760748`: no test function in (EP1) proves `limsup n_χ / log² q ≤ c` with
`c < 0.760748`. -/
theorem dual2_barrier : (0.760748 : ℝ) ≤ ((1.146514 : ℝ) ^ 2)⁻¹ := by norm_num

end DetPrimality.Barrier
